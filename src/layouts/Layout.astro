---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SGEB - Inicio Seguro de Sesión (SSO Gobernado)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · SGEB</title>
  </head>
  <body>
    <main class="sso-card">
      <!-- Logo Oficial Mediocres SGEB (Copa/Vaso + Nodos) -->
      <div class="logo-box">
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Copa / Vaso -->
          <path d="M 30 35 L 70 35 L 58 65 L 58 80 L 42 80 L 42 65 Z" stroke="#2C2C2A" stroke-width="3" stroke-linejoin="round" fill="none"/>
          <!-- Nodo Central -->
          <circle cx="50" cy="24" r="5" fill="#2C2C2A" />
          <!-- Nodos Conectados -->
          <circle cx="34" cy="20" r="3.5" fill="#B4A9A1" />
          <circle cx="66" cy="20" r="3.5" fill="#B4A9A1" />
          <!-- Líneas de Conexión -->
          <path d="M 34 20 Q 42 22 50 24 Q 58 22 66 20" stroke="#B4A9A1" stroke-width="1.5" stroke-dasharray="3 3" fill="none"/>
        </svg>
      </div>

      <slot />
    </main>
  </body>
</html>
