---
import Layout from '../layouts/Layout.astro';
import { proxyApiRequest } from '../lib/api';

const ticket = Astro.url.searchParams.get('ticket') || '';
const enviado = Astro.url.searchParams.get('enviado') === '1';

let error: string | null = null;
let codigo: string | null = null;

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const ticketPost = formData.get('ticket')?.toString() || '';
    const correo = formData.get('correo')?.toString() || '';

    await proxyApiRequest('/interno/recuperar', 'POST', { ticket: ticketPost, correo });
    return Astro.redirect(`/recuperar?ticket=${encodeURIComponent(ticketPost)}&enviado=1`);
  } catch (err: any) {
    error = err.message || 'Error al procesar la solicitud.';
  }
}
---

<Layout title="Recuperar acceso">
  <div class="sso-header">
    <h1 class="sso-title">Recuperar acceso</h1>
    <p class="sso-subtitle">
      {enviado
        ? 'Si tu correo está registrado, te enviaremos un enlace para restablecer tu contraseña.'
        : 'Te enviaremos un enlace a tu correo'}
    </p>
  </div>

  {error && (
    <div class="alert-error">
      <span>{error}</span>
    </div>
  )}

  {!enviado ? (
    <form method="POST">
      <input type="hidden" name="ticket" value={ticket} />

      <div class="form-group">
        <label for="correo" class="form-label">Correo</label>
        <input
          id="correo"
          name="correo"
          type="email"
          class="form-input"
          required
          autofocus
          placeholder="tucorreo@correo.com"
        />
      </div>

      <button type="submit" class="btn-terracota">
        Enviar enlace
      </button>
    </form>
  ) : null}

  <div class="sso-footer">
    <a href={`/login?ticket=${encodeURIComponent(ticket)}`}>
      Volver a iniciar sesión
    </a>
  </div>
</Layout>
