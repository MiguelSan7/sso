---
import Layout from '../layouts/Layout.astro';
import { proxyApiRequest } from '../lib/api';

const ticket = Astro.url.searchParams.get('ticket') || '';
const correo = Astro.url.searchParams.get('correo') || '';

let error: string | null = null;
let codigo: string | null = null;

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const ticketPost = formData.get('ticket')?.toString() || '';
    const c1 = formData.get('c1')?.toString() || '';
    const c2 = formData.get('c2')?.toString() || '';
    const c3 = formData.get('c3')?.toString() || '';
    const c4 = formData.get('c4')?.toString() || '';
    const c5 = formData.get('c5')?.toString() || '';
    const c6 = formData.get('c6')?.toString() || '';
    const codigoIngresado = `${c1}${c2}${c3}${c4}${c5}${c6}`;
    const confiar = formData.get('confiar')?.toString() === '1';

    const res = await proxyApiRequest(
      '/interno/verificacion',
      'POST',
      { ticket: ticketPost, codigo: codigoIngresado, confiar: confiar ? '1' : '0' },
      { 
        cookie: Astro.request.headers.get('cookie') || '',
        'Content-Type': 'application/x-www-form-urlencoded'
      }
    );

    // Propagar cookies recibidas de AdonisJS al navegador (e.g., sso_session, sgeb_dispositivo)
    if (res.headers.setCookie) {
      Astro.response.headers.set('Set-Cookie', res.headers.setCookie);
    }

    if (res.ok) {
      const location = res.headers?.location;
      if (location) {
        return Astro.redirect(location);
      }
    } else {
      if (typeof res.data === 'string') {
        const errorMatch = res.data.match(/<div class="err"[^>]*><span>(.*?)<\/span>(?:<small>(.*?)<\/small>)?<\/div>/);
        if (errorMatch) {
          error = errorMatch[1];
          codigo = errorMatch[2] || 'ERR-AUTH-400';
        } else {
          error = 'Error al procesar el formulario en el backend';
          codigo = 'ERR-AUTH-500';
        }
      } else {
        error = res.data?.message || res.data?.error || 'Código incorrecto o expirado.';
        codigo = res.data?.codigo || res.data?.sso_code || 'ERR-AUTH-400';
      }
    }
  } catch (err: any) {
    error = err.message || 'Error en la verificación';
    codigo = 'ERR-AUTH-500';
  }
}
---

<Layout title="Verificación en dos pasos">
  <div class="sso-header">
    <h1 class="sso-title">Verifica que eres tú</h1>
    <p class="sso-subtitle">
      Código de 6 dígitos enviado a tu correo
    </p>
  </div>

  {error && (
    <div class="alert-error">
      <span>{error}</span>
      {codigo && <small>{codigo}</small>}
    </div>
  )}

  <form method="POST" id="form-2fa">
    <input type="hidden" name="ticket" value={ticket} />

    <div class="code-boxes">
      <input type="text" name="c1" maxlength="1" pattern="[0-9]" inputmode="numeric" required autofocus />
      <input type="text" name="c2" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
      <input type="text" name="c3" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
      <input type="text" name="c4" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
      <input type="text" name="c5" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
      <input type="text" name="c6" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
    </div>

    <div style="display: flex; justify-content: center; align-items: center; gap: 8px; margin: 20px 0; font-size: 14px;">
      <input
        type="checkbox"
        id="confiar"
        name="confiar"
        value="1"
        style="width: 16px; height: 16px; accent-color: var(--c-accion-principal);"
      />
      <label for="confiar" style="cursor: pointer; color: var(--c-oscuro-primario);">
        Confiar en este dispositivo 30 días
      </label>
    </div>

    <button type="submit" class="btn-terracota">
      Verificar
    </button>
  </form>

  <div class="sso-footer">
    <a href={`/interno/verificacion/reenviar?ticket=${encodeURIComponent(ticket)}`}>
      Reenviar código
    </a>
  </div>

  <script>
    // Auto-focus al siguiente input al teclear un dígito
    const inputs = document.querySelectorAll<HTMLInputElement>('.code-boxes input');
    inputs.forEach((input, index) => {
      input.addEventListener('input', (e) => {
        const val = input.value;
        if (val && index < inputs.length - 1) {
          inputs[index + 1].focus();
        }
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !input.value && index > 0) {
          inputs[index - 1].focus();
        }
      });
    });
  </script>
</Layout>
