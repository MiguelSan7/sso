---
import Layout from '../layouts/Layout.astro';

const mensaje = Astro.url.searchParams.get('mensaje') || 'Cuenta desactivada. Tu cuenta no está activa. Pide al capitán que la reactive.';
const codigo = Astro.url.searchParams.get('codigo') || 'Ref. ERR-AUTH-403';
---

<Layout title="Acceso denegado">
  <div class="sso-header">
    <h1 class="sso-title">No pudimos iniciar sesión</h1>
  </div>

  <div style="margin-bottom: 24px; padding: 14px 16px; border: 1px solid var(--c-error); background: rgba(163, 45, 45, 0.04); border-radius: 8px; color: var(--c-error); font-size: 14px; line-height: 1.5;">
    {mensaje}
  </div>

  <button type="button" class="btn-terracota" onclick="window.location.reload();">
    Reintentar
  </button>

  <div class="sso-footer">
    <a href="/recuperar" style="display: inline-block; margin-bottom: 12px;">
      Recuperar contraseña
    </a>
    <div style="font-size: 12px; color: var(--c-gris-medio);">{codigo}</div>
  </div>
</Layout>
