---
// Redirección inteligente ("IdP-Initiated Flow")
// Si un usuario despistado entra a la raíz del proveedor de identidad, 
// lo aventamos hacia el cliente (el Panel Web) para que inicie el flujo correctamente.

const isDev = import.meta.env.DEV;

if (isDev) {
  // En local, usamos nuestra propia ruta de pruebas que simula ser el Panel Web
  return Astro.redirect('/test');
} else {
  // En producción, lo mandamos al dominio principal de la aplicación.
  // El Panel Web detectará que no tiene sesión y armará la URL de /authorize correctamente.
  const panelUrl = import.meta.env.PUBLIC_PANEL_URL || 'https://sgeb.mediocres.mx';
  return Astro.redirect(panelUrl);
}
---
